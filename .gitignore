# Build artifacts generated by ./configure
/Makefile
/poplog

# Build artifacts generated by make
/corepop
/corepop.amd64
/empty.a
/empty.p
/empty.w
/stamp_*
/target/

# Captured build logs (validation work)
/build-*.log

# Generated documentation indexes (created during make)
pop/doc/index
pop/teach/index
pop/**/help/*index
pop/**/ref/*index
pop/**/ref/doc_index/
pop/**/teach/*index

# ci-watch.sh runtime logs
tools/ci-watch.build.log
tools/ci-watch.log

# Vendored third-party source (fetched by tools/fetch-imgui.sh, not committed)
/pop/extern/imgui/

# Standalone smoke-test binaries (make gfx-smoke / make jit-smoke)
/gfx-smoke
/jit-smoke

# nix build output symlinks
result
result-*

# Educational material fetched by tools/fetch-learning.sh (never committed)
/learn/

# Built by tools/build-popcrypto.sh (LIB CRYPTO shim)
pop/extern/popcrypto/*.so
pop/extern/popcrypto/*.dylib

# Per-machine Claude Code settings (never committed)
.claude/settings.local.json
# release artifacts (uploaded to GitHub Releases, never committed)
dist/
pop/extern/popcurl/*.so
pop/extern/popcurl/*.dylib
pop/extern/poppcre/*.so
pop/extern/poppcre/*.dylib

# Generated documentation site and release staging
/dist/

# Release/CI build output (tarballs, docs site, sandboxes)
/dist/
__pycache__/

# tools/ci/pack-tree.sh output and the metadata it embeds; the packer
# removes the two dotfiles on exit, but a CI workspace that unpacked a
# tree keeps them
poplog-src.tar.gz
.ci-manifest
.ci-commit

# A JupyterLab session over examples/notebooks/ leaves these behind.  The
# notebooks there are committed WITH their outputs, which are genuine engine
# results, so a checkpoint copy of one is noise that invites a confusing
# diff -- and lab re-saves an open notebook, stripping execution timings.
.ipynb_checkpoints/
Untitled*.ipynb
