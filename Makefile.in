# The smoke-test convenience targets (gfx-smoke etc.) are defined before
# "all", so pin the default goal or a bare "make" would run the first one
.DEFAULT_GOAL := all

usepop = @@USEPOP@@
ABS_BUILD = @@ABS_BUILD@@
poptarget = ${ABS_BUILD}/@@POP_target@@
popsys = ${poptarget}/pop
popliblib = ${usepop}/pop/lib/lib
popsavelib = ${poptarget}/psv
popobjlib = ${poptarget}/obj
popcobj = ${poptarget}
popexlib = ${poptarget}/exlib
DO_COMMAND = ${ABS_BUILD}/poplog
MK_CROSS = ${usepop}/scripts/mk_cross
PGLINK = ${usepop}/scripts/pglink
CC = @@CC@@
CC_LINK_OPTIONS = @@CC_LINK_OPTIONS@@
HASH_STYLE_OPT = @@HASH_STYLE_OPT@@

X_INCLUDES = @@X_INCLUDES@@
X_CONF = @@X_CONF@@
GFX_CONF = @@GFX_CONF@@
POP_arch = @@POP_arch@@

ifeq (${GFX_CONF},imgui)
# Experimental native graphics backend (Dear ImGui + Metal, macOS); no X linked.
# Glue: pop/extern/lib/imgui_backend.{h,mm}; ImGui vendored by ./tools/fetch-imgui.sh.
# The GFX objects are compiled into ${popexlib} and folded into the Poplog
# link via $POP_GFX_OBJECTS/$POP_GFX_LDFLAGS, which gen_link_command
# (syscomp/os_comms.p, Darwin branch) writes into poplink_cmnd as lazy
# shell expansions -- empty when unset, so non-gfx links are unaffected.
XL_FLAG=-nox
GFX_LINK_OBJS = ${popexlib}/imgui_backend.o ${popexlib}/imgui.o \
                ${popexlib}/imgui_draw.o ${popexlib}/imgui_tables.o \
                ${popexlib}/imgui_widgets.o ${popexlib}/imgui_impl_metal.o \
                ${popexlib}/imgui_impl_osx.o
GFX_LINK_LDFLAGS = -lc++ -framework Metal -framework MetalKit -framework Cocoa \
                   -framework QuartzCore -framework GameController -framework Carbon
export POP_GFX_OBJECTS = ${GFX_LINK_OBJS}
export POP_GFX_LDFLAGS = ${GFX_LINK_LDFLAGS}
else ifeq (${GFX_CONF},imgui-sdl)
# Experimental native graphics backend (Dear ImGui + SDL3 + OpenGL3).  Cross
# platform: Linux/Unix (SDL3 dlopen's Wayland/X11/kmsdrm at run time -> no hard
# X11 dependency) AND macOS (SDL3 over Cocoa, OpenGL core profile).  Glue:
# pop/extern/lib/imgui_backend_sdl.cpp.  gen_link_command (syscomp/os_comms.p)
# folds $POP_GFX_OBJECTS/$POP_GFX_LDFLAGS into the poplink command.
# SDL3 + OpenGL compile/link flags are resolved by ./configure (pkg-config or
# SDL3_CFLAGS/SDL3_LIBS, plus the OS-specific GL link), so no pkg-config here.
XL_FLAG=-nox
GFX_CXX        = c++
GFX_INCLUDES   = -I${GFX_IMGUI} -I${GFX_IMGUI}/backends -Ipop/extern/lib @@GFX_SDL_CFLAGS@@
GFX_LINK_OBJS  = ${popexlib}/imgui_backend_sdl.o ${popexlib}/imgui.o \
                 ${popexlib}/imgui_draw.o ${popexlib}/imgui_tables.o \
                 ${popexlib}/imgui_widgets.o ${popexlib}/imgui_impl_sdl3.o \
                 ${popexlib}/imgui_impl_opengl3.o
GFX_LINK_LDFLAGS = @@GFX_SDL_LIBS@@
export POP_GFX_OBJECTS = ${GFX_LINK_OBJS}
export POP_GFX_LDFLAGS = ${GFX_LINK_LDFLAGS}
else
ifeq (${X_CONF},no)
XL_FLAG=-nox
else
XT_OBJECT=${popexlib}/XtPoplog.o
XPW_TARGETS=${popexlib}/libXpw.so stamp_xlib
XVED_TARGET=stamp_xved
ifeq (${X_CONF},xt)
XL_FLAG=-xt
else
XL_FLAG=-xm
endif
endif
endif

# --- Experimental graphics backend (Dear ImGui + Metal, macOS) -------------
# Vendored ImGui (./tools/fetch-imgui.sh) + the glue in pop/extern/lib.  These
# vars also feed the eventual basepop11 integration (GFX_OBJECT/GFX_FRAMEWORKS).
GFX_IMGUI      ?= pop/extern/imgui
GFX_CXX        ?= clang++
GFX_INCLUDES   ?= -I${GFX_IMGUI} -I${GFX_IMGUI}/backends -Ipop/extern/lib
GFX_FRAMEWORKS ?= -framework Metal -framework MetalKit -framework Cocoa \
                  -framework QuartzCore -framework GameController -framework Carbon
GFX_IMGUI_SRCS ?= ${GFX_IMGUI}/imgui.cpp ${GFX_IMGUI}/imgui_draw.cpp \
                  ${GFX_IMGUI}/imgui_tables.cpp ${GFX_IMGUI}/imgui_widgets.cpp \
                  ${GFX_IMGUI}/backends/imgui_impl_metal.mm \
                  ${GFX_IMGUI}/backends/imgui_impl_osx.mm
GFX_GLUE_SRC   ?= pop/extern/lib/imgui_backend.mm

# Standalone smoke test: build + link the whole graphics stack into a window and
# render a few frames (no Poplog needed) -- proves the --experimental-gfx
# toolchain.  Usage: ./tools/fetch-imgui.sh && make gfx-smoke && ./gfx-smoke
.PHONY: gfx-smoke
gfx-smoke:
	@test -f ${GFX_IMGUI}/imgui.cpp || { echo "Run ./tools/fetch-imgui.sh first."; exit 1; }
	clang++ -std=c++17 -fobjc-arc ${GFX_INCLUDES} \
	    ${GFX_GLUE_SRC} pop/extern/lib/imgui_smoke.mm ${GFX_IMGUI_SRCS} \
	    ${GFX_FRAMEWORKS} -o gfx-smoke

# Linux/Unix smoke: SDL3 + OpenGL3.  Usage:
#   ./tools/fetch-imgui.sh && make gfx-smoke-sdl && ./gfx-smoke-sdl
# SDL3 headers/libs via pkg-config (set PKG_CONFIG_PATH if not on the system).
.PHONY: gfx-smoke-sdl
gfx-smoke-sdl:
	@test -f ${GFX_IMGUI}/imgui.cpp || { echo "Run ./tools/fetch-imgui.sh first."; exit 1; }
	${GFX_CXX} -std=c++17 -O2 \
	    -I${GFX_IMGUI} -I${GFX_IMGUI}/backends -Ipop/extern/lib $(shell pkg-config --cflags sdl3) \
	    pop/extern/lib/imgui_backend_sdl.cpp pop/extern/lib/imgui_smoke.cpp \
	    ${GFX_IMGUI}/imgui.cpp ${GFX_IMGUI}/imgui_draw.cpp \
	    ${GFX_IMGUI}/imgui_tables.cpp ${GFX_IMGUI}/imgui_widgets.cpp \
	    ${GFX_IMGUI}/backends/imgui_impl_sdl3.cpp ${GFX_IMGUI}/backends/imgui_impl_opengl3.cpp \
	    $(shell pkg-config --libs sdl3) -lGL -o gfx-smoke-sdl
	@echo "Built ./gfx-smoke-sdl -- run it to open the window."

# Headless render harness (Linux/Unix): SDL3 offscreen (EGL surfaceless) +
# OpenGL3, renders the scene to a PPM with NO display/GPU/compositor (Mesa
# llvmpipe).  This is the CI / regression primitive -- see
# tools/validate-gfx-headless.sh.  Usage:
#   ./tools/fetch-imgui.sh && make gfx-headless && ./gfx-headless out.ppm
.PHONY: gfx-headless
gfx-headless:
	@test -f ${GFX_IMGUI}/imgui.cpp || { echo "Run ./tools/fetch-imgui.sh first."; exit 1; }
	${GFX_CXX} -std=c++17 -O2 \
	    -I${GFX_IMGUI} -I${GFX_IMGUI}/backends -Ipop/extern/lib $(shell pkg-config --cflags sdl3) \
	    pop/extern/lib/imgui_backend_sdl.cpp pop/extern/lib/imgui_headless.cpp \
	    ${GFX_IMGUI}/imgui.cpp ${GFX_IMGUI}/imgui_draw.cpp \
	    ${GFX_IMGUI}/imgui_tables.cpp ${GFX_IMGUI}/imgui_widgets.cpp \
	    ${GFX_IMGUI}/backends/imgui_impl_sdl3.cpp ${GFX_IMGUI}/backends/imgui_impl_opengl3.cpp \
	    $(shell pkg-config --libs sdl3) -lGL -o gfx-headless
	@echo "Built ./gfx-headless -- ./gfx-headless out.ppm renders with no display."

# W^X JIT smoke test (PORTING-ARM64-M-SILICON-OSX.md Phase 4): JIT a tiny AArch64
# function into MAP_JIT memory and call it -- proves the Apple-Silicon write->
# execute cycle (pop/extern/lib/pop_jit.c) without a Poplog build.
.PHONY: jit-smoke
jit-smoke:
	clang -O2 -Wall -Ipop/extern/lib \
	    pop/extern/lib/pop_jit.c pop/extern/lib/pop_jit_smoke.c -o jit-smoke
	@echo "Built ./jit-smoke -- run it to verify the W^X JIT cycle."

PACK_CONF = @@PACK_CONF@@

ifeq (${PACK_CONF},yes)
PACKAGES_DIR_TARGET = stamp_package_dirs_and_symlinks
PACKAGES_LIB_TARGET = stamp_packages
PACKAGES_CLEAN_TARGET = clean_packages
endif

all: stamp_images stamp_indexes ${PACKAGES_LIB_TARGET}

stamp_dirs_and_symlinks: ${PACKAGES_DIR_TARGET}
	-(cd ${popsys} && { ln -s corepop popc ; \
	  ln -s corepop poplibr ; ln -s corepop poplink ; } )
	mkdir -p ${popsavelib} ${popexlib} ${popobjlib}
	mkdir -p ${popcobj}/src ${popcobj}/ved/src ${popcobj}/x/src
	mkdir -p pop/ref/doc_index
	mkdir -p pop/lib/objectclass/ref/doc_index
	mkdir -p pop/lisp/ref/doc_index
	mkdir -p pop/x/ved/ref/doc_index
	touch stamp_dirs_and_symlinks

SYSCOMP_SRC = $(wildcard pop/src/syscomp/*.p) \
              $(wildcard pop/src/syscomp/*.ph) \
              $(wildcard pop/src/syscomp/${POP_arch}/*.p) \
              $(wildcard pop/src/${POP_arch}/*.s)

stamp_popc: ${popsys}/corepop stamp_dirs_and_symlinks ${SYSCOMP_SRC}
	(cd pop/src; CC_LINK_OPTIONS="${CC_LINK_OPTIONS}" ; \
	   export CC_LINK_OPTIONS; ${DO_COMMAND} ${MK_CROSS} \
	   -d -a=${POP_arch} popc poplibr poplink)
	touch stamp_popc

stamp_new_corepop: stamp_popc stamp_srclib ${popexlib}/libpop.a ${popexlib}/pop_seed_loader.o ${GFX_LINK_OBJS}
	(cd ${popsys} && POP__cc="${CC} ${HASH_STYLE_OPT}"; \
	    export POP__cc && \
	    ${DO_COMMAND} ${PGLINK} -core && \
	    mv newpop11 new_corepop )
	touch stamp_new_corepop

SRC_PSRC = $(wildcard pop/src/*.p) $(wildcard pop/src/${POP_arch}/*.[ps])
SRC_SRC = ${SRC_PSRC} \
          $(wildcard pop/src/*.ph) pop/lib/include/ast.ph \
          pop/lib/include/doc_index.ph pop/lib/include/itemise.ph \
          pop/lib/include/pop11_flags.ph pop/lib/include/sigdefs.ph \
          pop/lib/include/subsystem.ph pop/lib/include/sysdefs.ph \
          pop/lib/include/unix_errno.ph pop/lib/include/vedfile_struct.ph \
          pop/lib/include/vedscreendefs.ph pop/lib/include/vm_flags.ph
SRC_W := $(addsuffix .w, $(basename \
           $(patsubst termcap.p,, $(notdir ${SRC_PSRC}))))

# NB: the .olb (object) halves must be removed too, not just the .wlb (word)
# halves.  poplink links ${popobjlib}/src.olb for the machine code of anything
# compiled from pop/src -- notably the hand-written pop/src/${POP_arch}/*.s --
# and poplibr UPDATES an existing library rather than recreating it.  Leaving
# src.olb in place lets a stale member shadow a freshly rebuilt one: the .w is
# current, the link succeeds, and the engine silently keeps the OLD machine
# code.  See docs/bugs/stale-olb-shadows-rebuild.md.
stamp_srclib: stamp_popc ${SRC_SRC}
	-rm ${popobjlib}/src.wlb ${popobjlib}/termcap.wlb
	-rm ${popobjlib}/src.olb ${popobjlib}/termcap.olb
	-rm ${popcobj}/src/*.[ow]
	(cd pop/src && \
	    ${DO_COMMAND} popc -c -nosys -od ${popcobj}/src \
	       ${POP_arch}/*.[ps] *.p)
	(cd ${popcobj}/src && \
	    ${DO_COMMAND} poplibr -c ${popobjlib}/src.wlb ${SRC_W} && \
	    ${DO_COMMAND} poplibr -c ${popobjlib}/termcap.wlb termcap.w )
	touch stamp_srclib

VED_SRC = $(wildcard pop/ved/src/*.p) $(wildcard pop/ved/src/*.ph) \
          pop/src/syspop.ph pop/lib/include/ved_declare.ph \
          pop/lib/include/vedfile_struct.ph \
          pop/lib/include/vedscreendefs.ph

stamp_vedlib: stamp_srclib
	-rm ${popobjlib}/vedsrc.wlb ${popobjlib}/vedsrc.olb
	-rm ${popcobj}/ved/src/*.[ow]
	(cd pop/ved/src && \
	    ${DO_COMMAND} popc -c -nosys -od ${popcobj}/ved/src \
	       -wlib \( ../../src/ ${popobjlib}/termcap.wlb \) *.p)
	(cd ${popcobj}/ved/src && \
	    ${DO_COMMAND} poplibr -c ${popobjlib}/vedsrc.wlb *.w \
	       ${popcobj}/src/termcap.w )
	touch stamp_vedlib

stamp_xlib: stamp_srclib
	-rm ${popobjlib}/xsrc.wlb ${popobjlib}/xsrc.olb
	-rm ${popcobj}/x/src/*.[ow]
	(cd pop/x/src && \
	    ${DO_COMMAND} popc -c -nosys -od ${popcobj}/x/src \
	       -wlib \( ../../src/ \) *.p )
	(cd ${popcobj}/x/src && \
	    ${DO_COMMAND} poplibr -c ${popobjlib}/xsrc.wlb *.w )
	touch stamp_xlib

stamp_newpop: stamp_popc
	(cd ${popsys} && \
	    ${DO_COMMAND} ./corepop %nort ${popliblib}/mkimage.p \
               -entrymain ./newpop.psv ${popliblib}/newpop.p )
	touch stamp_newpop

LIBPOP_CSRC = c_bignum c_callback c_core c_sysinit ext_arm \
              pop_encoding pop_poll pop_stat pop_timer pop_vararg_fix

LIBPOP_OBJS0 = $(addprefix ${popexlib}/, $(addsuffix .o, \
                $(basename $(notdir ${LIBPOP_CSRC}))))

LIBPOP_OBJS = ${LIBPOP_OBJS0} ${XT_OBJECT} ${GFX_OBJECT}

# Poplog's C externs are legacy K&R/C89 (e.g. `typedef unsigned bool`,
# unprototyped `()` signal handlers). GCC 14 promoted several warnings to hard
# errors and GCC 15 defaults to C23 (where `bool` is a keyword and `()` means
# `(void)`) -- both reject this code. Compile the extern lib as C17 and don't
# fail on the pre-standard pointer conversions. Dropping this pin back to the
# compiler default needs the C23 source modernisation tracked in
# docs/bugs/c23-modernization.md.
POPCFLAGS = -std=gnu17 -Wno-error=incompatible-pointer-types

${LIBPOP_OBJS0}: ${popexlib}/%.o: pop/extern/lib/%.c stamp_dirs_and_symlinks
	$(CC) -c -g -Wall -O $(POPCFLAGS) $< -o $@

${popexlib}/XtPoplog.o: pop/extern/lib/XtPoplog.c stamp_dirs_and_symlinks
	$(CC) -c -g -Wall -O $(POPCFLAGS) $(X_INCLUDES) $< -o $@

${popexlib}/pop_seed_loader.o: pop/extern/lib/pop_seed_loader.c stamp_dirs_and_symlinks
	$(CC) -c -g -Wall -O $(POPCFLAGS) $< -o $@

# GFX object compilation (only built when referenced -- GFX_CONF=imgui*).
# The ImGui core + SDL/GL backends compile with ${GFX_CXX} (clang++ on macOS,
# c++ on Linux); the ObjC++ Metal/Cocoa backends are macOS-only (clang++ -ARC).
${popexlib}/imgui.o: ${GFX_IMGUI}/imgui.cpp stamp_dirs_and_symlinks
	${GFX_CXX} -std=c++17 -O2 ${GFX_INCLUDES} -c $< -o $@
${popexlib}/imgui_draw.o: ${GFX_IMGUI}/imgui_draw.cpp stamp_dirs_and_symlinks
	${GFX_CXX} -std=c++17 -O2 ${GFX_INCLUDES} -c $< -o $@
${popexlib}/imgui_tables.o: ${GFX_IMGUI}/imgui_tables.cpp stamp_dirs_and_symlinks
	${GFX_CXX} -std=c++17 -O2 ${GFX_INCLUDES} -c $< -o $@
${popexlib}/imgui_widgets.o: ${GFX_IMGUI}/imgui_widgets.cpp stamp_dirs_and_symlinks
	${GFX_CXX} -std=c++17 -O2 ${GFX_INCLUDES} -c $< -o $@
# macOS (Metal + Cocoa) glue + backends -- ObjC++
${popexlib}/imgui_backend.o: pop/extern/lib/imgui_backend.mm stamp_dirs_and_symlinks
	clang++ -std=c++17 -fobjc-arc -O2 ${GFX_INCLUDES} -c $< -o $@
${popexlib}/imgui_impl_metal.o: ${GFX_IMGUI}/backends/imgui_impl_metal.mm stamp_dirs_and_symlinks
	clang++ -std=c++17 -fobjc-arc -O2 ${GFX_INCLUDES} -c $< -o $@
${popexlib}/imgui_impl_osx.o: ${GFX_IMGUI}/backends/imgui_impl_osx.mm stamp_dirs_and_symlinks
	clang++ -std=c++17 -fobjc-arc -O2 ${GFX_INCLUDES} -c $< -o $@
# Linux/Unix (SDL3 + OpenGL3) glue + backends -- plain C++
${popexlib}/imgui_backend_sdl.o: pop/extern/lib/imgui_backend_sdl.cpp stamp_dirs_and_symlinks
	${GFX_CXX} -std=c++17 -O2 ${GFX_INCLUDES} -c $< -o $@
${popexlib}/imgui_impl_sdl3.o: ${GFX_IMGUI}/backends/imgui_impl_sdl3.cpp stamp_dirs_and_symlinks
	${GFX_CXX} -std=c++17 -O2 ${GFX_INCLUDES} -c $< -o $@
${popexlib}/imgui_impl_opengl3.o: ${GFX_IMGUI}/backends/imgui_impl_opengl3.cpp stamp_dirs_and_symlinks
	${GFX_CXX} -std=c++17 -O2 ${GFX_INCLUDES} -c $< -o $@


${popexlib}/libpop.a: ${LIBPOP_OBJS}
	ar rc $@ $^

XPW_CSRC = $(wildcard pop/x/Xpw/*.c)
XPW_OBJS = $(addprefix ${popexlib}/,$(addsuffix .o, \
             $(basename $(notdir ${XPW_CSRC}))))

XPW_HSRC = $(wildcard pop/x/Xpw/*.h)

${XPW_OBJS}: ${popexlib}/%.o: pop/x/Xpw/%.c ${XPW_HSRC} stamp_dirs_and_symlinks
	$(CC) -c -g -Wall -fPIC $(X_INCLUDES) $< -o $@

${popexlib}/libXpw.so: ${XPW_OBJS}
	$(CC) -g -shared -o $@ $^

${popsys}/basepop11: ${popexlib}/libpop.a ${XPW_TARGETS} ${GFX_LINK_OBJS} \
                     stamp_popc stamp_vedlib ${popexlib}/pop_seed_loader.o
	(cd ${popsys} && POP__cc="${CC}"; export POP__cc && \
	   rm -f basepop11 clisp pml pop11 prolog ved xved && \
	   ${DO_COMMAND} ${PGLINK} ${XL_FLAG} -map && \
	   mv newpop11 basepop11 && ln basepop11 pop11 && \
	   mv newpop11.map basepop11.map && \
	   mv newpop11.stb basepop11.stb )

${popsavelib}/startup.psv: ${popsys}/basepop11
	${DO_COMMAND} ${popsys}/basepop11 %nort %noinit \
	  ${popliblib}/mkimage.p -nodebug -nonwriteable -install \
	  ${popsavelib}/startup.psv startup

BIN_START = ${popsavelib}/startup.psv ${popsys}/basepop11

MK_IMAGE = ${DO_COMMAND} ${popsys}/pop11 %nort %noinit ${popliblib}/mkimage.p

stamp_clisp: ${BIN_START}
	${MK_IMAGE} -install -subsystem lisp \
	  ${popsavelib}/clisp.psv ${usepop}/pop/lisp/src/clisp.p
	touch stamp_clisp

stamp_plog: ${BIN_START}
	${MK_IMAGE} -nodebug -install -flags prolog \( \) \
	  ${popsavelib}/prolog.psv ${usepop}/pop/plog/src/prolog.p
	touch stamp_plog

stamp_pml: ${BIN_START}
	${MK_IMAGE} -nodebug -install -flags ml \( \) \
	  ${popsavelib}/pml.psv ${usepop}/pop/pml/src/ml.p
	touch stamp_pml

stamp_xved: ${BIN_START}
	${MK_IMAGE} -nodebug -nonwriteable -install \
	  -entry xved_standalone_setup \
	  ${popsavelib}/xved.psv mkxved
	touch stamp_xved

stamp_images: stamp_clisp stamp_plog stamp_pml ${XVED_TARGET}
	(cd ${popsys} && \
	  for A in clisp pml prolog ved xved; do \
	     ln basepop11 $$A || true ; \
	  done)
	touch stamp_images

# support for packages

PACKAGES_SRC_DIR = ${usepop}/pop/packages

# neural libraries

NEURAL_LIB_NAMES = backprop  complearn ranvecs

NEURAL_DIR = ${poptarget}/packages/neural/bin/${POP_arch}

NEURAL_LIBS = $(addprefix ${NEURAL_DIR}/, \
                          $(addsuffix .so, ${NEURAL_LIB_NAMES}))

NEURAL_CSRC = ${PACKAGES_SRC_DIR}/neural/src/c

${NEURAL_LIBS}: ${NEURAL_DIR}/%.so: ${NEURAL_CSRC}/%.c \
                ${NEURAL_CSRC}/neural.h stamp_dirs_and_symlinks
	$(CC) -g -O2 -Wall -fPIC -shared -I${NEURAL_CSRC} $< -o $@

# popvision libraries

VISION_DIR = ${poptarget}/packages/popvision/bin/${POP_arch}

VISION_CSRC = ${PACKAGES_SRC_DIR}/popvision/lib

VISION_LIB_NAMES = $(basename $(notdir \
                     $(wildcard ${VISION_CSRC}/*.c)))

VISION_LIBS = $(addprefix ${VISION_DIR}/, \
                          $(addsuffix .so, ${VISION_LIB_NAMES}))

${VISION_LIBS}: ${VISION_DIR}/%.so: ${VISION_CSRC}/%.c \
                 ${VISION_CSRC}/arrpack.h ${VISION_CSRC}/arrscan.h \
                 stamp_dirs_and_symlinks
	$(CC) -g -O2 -Wall -fPIC -shared -I${VISION_CSRC} $< -o $@

stamp_packages: ${NEURAL_LIBS} ${VISION_LIBS}
	touch stamp_packages

stamp_package_dirs_and_symlinks:
	-mkdir -p ${VISION_DIR} ${NEURAL_DIR}
	-mkdir -p ${PACKAGES_SRC_DIR}/lib
	-(cd ${PACKAGES_SRC_DIR}/lib; \
	  for A in $$(ls ..) ; do \
	    if [ -f "../$$A/$$A.p" ] ; then \
	        ln -s ../$$A/$$A.p . ; \
	    fi \
	  done)
	-mkdir -p ${PACKAGES_SRC_DIR}/neural/ref/doc_index
	-mkdir -p ${PACKAGES_SRC_DIR}/newkit/prb/ref/doc_index
	-mkdir -p ${PACKAGES_SRC_DIR}/newkit/sim/ref/doc_index
	-mkdir -p ${PACKAGES_SRC_DIR}/rclib/ref/doc_index
	touch stamp_package_dirs_and_symlinks

clean_packages:
	rm -f ${NEURAL_LIBS} ${VISION_LIBS}

stamp_indexes: ${BIN_START}
	${DO_COMMAND} ${popsys}/basepop11 make_indexes ${usepop}/pop
	touch stamp_indexes

buildclean:
	rm -f stamp_*
	rm -f ${LIBPOP_OBJS} ${XPW_OBJS}
	rm -f ${popcobj}/src/*.[ow]
	rm -f ${popcobj}/ved/src/*.[ow] ${popcobj}/x/src/*.[ow]

clean: buildclean ${PACKAGES_CLEAN_TARGET}
	(cd ${popsys} && \
	  rm -f basepop11 clisp newpop11 oldpop11 pml pop11 prolog \
	     ved xved ref teach im doc help basepop11.map \
	     *.map *.stb )
	rm -f ${popexlib}/libpop.a ${popexlib}/libXpw.so \
	   ${popsys}/*.psv* ${popsys}/poplink_* ${popsavelib}/* ${popobjlib}/*
